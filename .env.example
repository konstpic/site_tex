# ЮKassa — значения из личного кабинета (для тестов используйте тестовые shopId и секретный ключ).
# Документация: https://yookassa.ru/developers/api
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# URL возврата после оплаты (должен совпадать с настройками магазина при необходимости)
YOOKASSA_RETURN_URL=http://localhost:3000/payment/success

# ИНН самозанятого (для страницы реквизитов и подвала — требования ЮKassa при подключении оплаты)
INN=

# Публичные контакты сайта (используются в header/footer/контактах/корзине)
NEXT_PUBLIC_SITE_PHONE=+79999999999   # номер телефона
NEXT_PUBLIC_SITE_PHONE_DISPLAY=+7 999 999-99-99
NEXT_PUBLIC_SITE_EMAIL=example@example.com
