# Шлюз: yookassa | robokassa
PAYMENT_GATEWAY=robokassa

# URL страницы успеха (и для ЮKassa return_url, и для SuccessURL в ЛК Robokassa)
YOOKASSA_RETURN_URL=http://localhost:3000/payment/success
# Опционально отдельный URL успеха (иначе используется YOOKASSA_RETURN_URL)
# PAYMENT_SUCCESS_URL=

# ─── ЮKassa (при PAYMENT_GATEWAY=yookassa) ───
# Документация: https://yookassa.ru/developers/api
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ─── Robokassa (при PAYMENT_GATEWAY=robokassa) ───
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_IS_TEST=false
ROBOKASSA_HASH_ALGORITHM=md5
# Ставка в чеке: none | vat0 | vat10 | vat20 …
ROBOKASSA_RECEIPT_ITEM_TAX=vat20
# Опционально система налогообложения в JSON чека: osn | usn_income | …
# ROBOKASSA_SNO=osn

# ResultURL в личном кабинете Robokassa (доступен из интернета):
# https://<ваш-домен>/api/payments/robokassa/result

# ИНН самозанятого (оферта, реквизиты, подвал; например из публичной оферты)
INN=712100420505

# Публичные контакты сайта (используются в header/footer/контактах/корзине)
NEXT_PUBLIC_SITE_PHONE=+79534255793
NEXT_PUBLIC_SITE_PHONE_DISPLAY=+7 953 425-57-93
NEXT_PUBLIC_SITE_EMAIL=anisimova_es@mail.ru

# Telegram: уведомления о заявках перед оплатой (POST /api/payments/checkout)
# Токен от @BotFather; chat_id — ваш id (@userinfobot) или id группы (включая минус)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=